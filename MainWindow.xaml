<Window x:Class="LinguaOrb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinguaOrb 即时翻译助手"
        Width="470" Height="610"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded">
    <Grid>
        <Border x:Name="Card" Visibility="Collapsed" Margin="8,8,100,82"
                Background="#FFFDFB" BorderBrush="#E8E1FF" BorderThickness="1"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity=".22" Color="#433C68"/>
            </Border.Effect>
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Margin="0,0,35,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" Margin="0,0,9,0" CornerRadius="11" Background="#FFF5E8">
                                <Image Source="Assets/luming-logo.png" Margin="3" Stretch="Uniform"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="鹿鸣 · LinguaOrb" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                <TextBlock x:Name="ModeSubtitle" Text="把中文变成今天的新单词" Margin="0,2,0,0" FontSize="11" Foreground="#88829E"/>
                            </StackPanel>
                        </StackPanel>
                        <UniformGrid Columns="4" Margin="0,8,0,0">
                            <Button x:Name="ZhWordModeButton" Content="中→英" Height="28" FontSize="11"
                                    Click="ZhWordMode_Click" Background="#7C63D9" Foreground="White" BorderThickness="0"/>
                            <Button x:Name="EnWordModeButton" Content="英→中" Height="28" FontSize="11"
                                    Click="EnWordMode_Click" Background="#EEEAF8" Foreground="#655E74" BorderThickness="0"/>
                            <Button x:Name="ParagraphModeButton" Content="中段→英" Height="28" FontSize="10"
                                    Click="ParagraphMode_Click" Background="#EEEAF8" Foreground="#655E74" BorderThickness="0"/>
                            <Button x:Name="EnParagraphModeButton" Content="英段→中" Height="28" FontSize="10"
                                    Click="EnParagraphMode_Click" Background="#EEEAF8" Foreground="#655E74" BorderThickness="0"/>
                        </UniformGrid>
                    </StackPanel>
                    <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="30" Height="30" FontSize="18" Click="Close_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#8F88A8"/>
                </Grid>

                <Border Grid.Row="1" Margin="0,12,0,12" CornerRadius="14" Background="#F4F1FC"
                        BorderBrush="#E2DAF8" BorderThickness="1">
                    <TextBox x:Name="InputBox" Margin="14,11" MinHeight="42" MaxHeight="90"
                             FontSize="16" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource InkBrush}"
                             ToolTip="输入中文，例如：蝴蝶"/>
                </Border>

                <Button x:Name="TranslateButton" Grid.Row="2" Height="44" Content="翻  译" Click="Translate_Click"
                        FontSize="15" FontWeight="SemiBold" Foreground="White"
                        Background="{StaticResource PurpleBrush}" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border x:Name="WordResultCard" Grid.Row="3" Margin="0,16,0,0" Padding="16,13" CornerRadius="16" Background="#FFF1EB">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="WordText" Text="butterfly" FontSize="26" FontWeight="Bold" Foreground="#E86855"/>
                            <Button x:Name="SpeakButton" Content="🔊 英式发音" HorizontalAlignment="Right"
                                    Padding="11,6" VerticalAlignment="Center" Click="Speak_Click"
                                    Background="#FFFDFB" Foreground="#655B79" BorderBrush="#E8D7D1"
                                    ToolTip="播放标准英式发音"/>
                        </Grid>
                        <TextBlock x:Name="IpaText" Text="/ˈbʌtəflaɪ/" Margin="0,5,0,0" FontSize="15" Foreground="#574F68"/>
                        <TextBlock x:Name="PhonicsText" Text="自然拼读：but · ter · fly" Margin="0,5,0,0" FontSize="13" Foreground="#80778F"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Grid.Row="4" Margin="3,8,0,4" FontSize="11"
                           Foreground="#9A91AA" Text="在线词典 · 支持断网示例词"/>

                <Border Grid.Row="5" Margin="0,4,0,0" CornerRadius="16" ClipToBounds="True" Background="#FFF8E8">
                    <Grid>
                        <Image x:Name="IllustrationImage" Source="Assets/owl.png" Stretch="UniformToFill"/>
                        <Border x:Name="ImageLoadingBadge" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="8" Padding="8,4" CornerRadius="9" Background="#CCFFFFFF">
                            <TextBlock Text="正在寻找配图…" FontSize="10" Foreground="#716887"/>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ParagraphResultCard" Grid.Row="3" Grid.RowSpan="3" Visibility="Collapsed"
                        Margin="0,16,0,0" Padding="12" CornerRadius="16" Background="#F8F6FD"
                        BorderBrush="#E2DAF8" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ParagraphResultsPanel">
                            <TextBlock Text="输入中文段落后点击翻译" HorizontalAlignment="Center"
                                       Margin="0,18" Foreground="#8D86A0" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <StackPanel x:Name="ApiStatusPanel" Visibility="Collapsed"
                    Width="84" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,15,8,0">
            <UniformGrid Columns="2" Margin="0,0,0,5">
                <Button x:Name="TranslationTabButton" Content="翻译" Height="25" FontSize="10"
                        Click="TranslationTab_Click" Background="#7C63D9" Foreground="White"
                        BorderThickness="0"/>
                <Button x:Name="AudioTabButton" Content="声音" Height="25" FontSize="10"
                        Click="AudioTab_Click" Background="#EEEAF8" Foreground="#655E74"
                        BorderThickness="0"/>
            </UniformGrid>
            <StackPanel x:Name="TranslationNodesPanel"/>
            <StackPanel x:Name="AudioNodesPanel" Visibility="Collapsed"/>
        </StackPanel>

        <Button x:Name="OrbButton" Width="66" Height="66" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,13,8" Click="Orb_Click"
                ToolTip="打开 LinguaOrb">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="33" Background="#FFF7EA" BorderBrush="#7C63D9" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity=".35" Color="#5948A5"/>
                        </Border.Effect>
                        <Grid>
                            <Image Source="Assets/luming-logo.png" Margin="7" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
